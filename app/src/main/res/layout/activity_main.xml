<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0D1F12">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@mipmap/ic_launcher"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="OpenCheps"/>

            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="@string/tagline"
                    android:textColor="#FFA5D6A7"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#3300C853"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <TextView
            android:text="Which colour are you?"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Arrows only appear on YOUR turn. The app decides whose turn it is by what you tell it here."
            android:textColor="#FFB0BEC5"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <RadioGroup
            android:id="@+id/sideGroup"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/sideWhite"
                android:text="White"
                android:textColor="#FFFFFFFF"
                android:checked="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/sideBlack"
                android:text="Black"
                android:textColor="#FFFFFFFF"
                android:paddingStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <View
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#3300C853"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnReturnToBoard"
            android:text="@string/return_to_board"
            android:minHeight="48dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnOverlay"
            android:text="@string/grant_overlay"
            android:backgroundTint="#FF1B5E20"
            android:textColor="#FFFFFFFF"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnStart"
            android:text="@string/start"
            android:backgroundTint="#FF00C853"
            android:textColor="#FF0D1F12"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnStop"
            android:text="@string/stop"
            android:backgroundTint="#FFD32F2F"
            android:textColor="#FFFFFFFF"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/status"
            android:text="@string/status_idle"
            android:textColor="#FFA5D6A7"
            android:paddingTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_marginTop="20dp"
            android:background="#3300C853"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <TextView
            android:id="@+id/thinkLabel"
            android:text="@string/think_time_default"
            android:textColor="#FFFFFFFF"
            android:paddingTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/think_time_help"
            android:textColor="#FFB0BEC5"
            android:textSize="11sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/thinkBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/limitStrength"
            android:text="@string/limit_practice_strength"
            android:textColor="#FFFFFFFF"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/eloLabel"
            android:text="@string/practice_elo_default"
            android:textColor="#FFFFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/eloBar"
            android:contentDescription="@string/limit_practice_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/practice_elo_help"
            android:textColor="#FFB0BEC5"
            android:textSize="11sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/multiPvLabel"
            android:text="@string/move_choices_default"
            android:textColor="#FFFFFFFF"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/multiPvBar"
            android:contentDescription="@string/move_choices_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/showStudyLine"
            android:text="@string/show_study_line"
            android:textColor="#FFFFFFFF"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/study_line_help"
            android:textColor="#FFB0BEC5"
            android:textSize="11sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/how_it_works"
            android:textColor="#FFFFEB3B"
            android:textSize="12sp"
            android:paddingTop="22dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="@string/how_it_works_body"
            android:textColor="#FFB0BEC5"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
