<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:padding="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/panelDragHandle"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="48dp">
        <ImageButton
            android:id="@+id/panelIcon"
            android:src="@mipmap/ic_launcher"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/panel_minimize"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <ImageButton
            android:id="@+id/panelColor"
            android:src="@drawable/ic_side_white"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:contentDescription="@string/panel_color_white"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <ImageButton
            android:id="@+id/panelRecal"
            android:background="@drawable/panel_btn_alt"
            android:src="@android:drawable/ic_menu_rotate"
            android:padding="12dp"
            android:contentDescription="@string/position_read"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <LinearLayout
            android:id="@+id/panelExpandedActions"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="48dp">
            <ImageButton
                android:id="@+id/panelSettings"
                android:src="@drawable/ic_panel_settings"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/panel_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageButton
                android:id="@+id/panelToggle"
                android:src="@android:drawable/ic_media_pause"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/panel_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageButton
                android:id="@+id/panelStop"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/stop"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/panelExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/panelStatus"
                android:text="@string/status_starting"
                android:textColor="#FFA5D6A7"
                android:textSize="11sp"
                android:maxWidth="276dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <Button
                    android:id="@+id/panelTurn"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="@string/position_turn_white"
                    android:textAllCaps="false"
                    android:textColor="#FFD3E8DA"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"/>
                <Button
                    android:id="@+id/panelFlip"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="@string/position_bottom_white"
                    android:contentDescription="@string/position_flip"
                    android:textAllCaps="false"
                    android:textColor="#FFD3E8DA"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <Button
                    android:id="@+id/panelBoardArea"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="@string/board_area_set"
                    android:textAllCaps="false"
                    android:textColor="#FFD3E8DA"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"/>
                <Button
                    android:id="@+id/panelCheckBoard"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="@string/board_check"
                    android:textAllCaps="false"
                    android:textColor="#FFD3E8DA"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/panelEval"
                android:textColor="#FFFFEB3B"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:maxWidth="276dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/panelContinuation"
                android:textColor="#FFB0BEC5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxWidth="276dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:visibility="gone"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
